#!/bin/sh
set -e

RELEASE_VERSION=1.2.0
RELEASE_TITLE="${RELEASE_VERSION}"
RELEASE_NOTE="- upgrade to go 1.27
- dependency upgrade
- publish multi arch to apt-linux
- publish multi arch to rpms
